[Unit]
Description=Local solar spectrum display controller
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/solar-screen daemon --wait
ExecStopPost=-%h/.local/bin/solar-screen reset
Restart=on-failure
RestartSec=2
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
